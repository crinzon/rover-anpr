# Локальный .env не публикуется. URL ниже — только шаблон.
# Percent-encode спецсимволы логина/пароля; не передавайте URL аргументом CLI.
VIDEO_SOURCE=rtsp://USER:ENCODED_PASSWORD@CAMERA_IP:554/Streaming/Channels/101

# Адрес API
API_URL=http://127.0.0.1:8000/plates

# Устройство для нейросетей: mps, cpu или cuda
DEVICE=cuda

# Показывать окно OpenCV: true для Mac, false для Docker
SHOW_WINDOW=false

# Переподключение USB/RTSP: начальная и максимальная задержки, секунды.
VIDEO_RETRY_INITIAL=0.5
VIDEO_RETRY_MAX=10
# Предельное ожидание открытия или чтения; зависший процесс завершается.
VIDEO_OPERATION_TIMEOUT=5

# Доставка: очередь в памяти; при переполнении отбрасывается новое событие.
# После исчерпания попыток и при завершении остаток теряется с записью в лог.
DELIVERY_QUEUE_SIZE=256
DELIVERY_ATTEMPTS=5
DELIVERY_RETRY_INITIAL=0.5
DELIVERY_RETRY_MAX=10
DELIVERY_TIMEOUT=2

# auto: FFmpeg для RTSP, стандартный backend для USB/файлов.
VIDEO_BACKEND=auto
# Транспорт RTSP: tcp или udp. Для Hikvision начните с tcp.
RTSP_TRANSPORT=tcp
# Пример пути Hikvision: /Streaming/Channels/101 (основной), 102 (дополнительный).
# VIDEO_SOURCE=rtsp://USER:ENCODED_PASSWORD@CAMERA_IP:554/Streaming/Channels/101

# Живой просмотр /live: 1–30 FPS, ширина 320–3840, JPEG 30–100.
LIVE_FPS=20
LIVE_MAX_WIDTH=1920
LIVE_JPEG_QUALITY=90

# Максимальный возраст рамок относительно кадра превью, секунды.
LIVE_OVERLAY_MAX_AGE=0.25

# Временная диагностика полного тракта на /live?debug=1.
# Сырые выходы YOLO снимаются тем же forward pass; рабочие пороги не меняются.
ANPR_DIAGNOSTICS=false
ANPR_DIAGNOSTICS_INTERVAL=1
