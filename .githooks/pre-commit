#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

# A retry or an explicit version change must not bump the same commit twice.
if git diff --cached --quiet; then
    exit 0
fi
if ! git diff --quiet -- VERSION; then
    echo "VERSION has unstaged edits; stage or restore them before committing." >&2
    exit 1
fi
version=$(cat VERSION)
if ! printf '%s\n' "$version" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
    echo "VERSION must contain MAJOR.MINOR.PATCH." >&2
    exit 1
fi
if ! git diff --cached --quiet -- VERSION; then
    exit 0
fi
major=${version%%.*}
rest=${version#*.}
minor=${rest%%.*}
patch=${rest#*.}
printf '%s.%s.%s\n' "$major" "$minor" "$((patch + 1))" > VERSION
git add -- VERSION
# Never invoke git commit from a hook.
printf 'Version: %s -> %s\n' "$version" "$(cat VERSION)"
