# Ubuntu x86_64 + RTX A2000. Template only; never commit .env.
# Replace with actual camera URI. No real credentials are included.
VIDEO_SOURCE=rtsp://USER:ENCODED_PASSWORD@CAMERA_IP:554/Streaming/Channels/101
DEVICE=cuda
SHOW_WINDOW=false
VIDEO_BACKEND=auto
RTSP_TRANSPORT=tcp
VIDEO_RETRY_INITIAL=0.5
VIDEO_RETRY_MAX=10
VIDEO_OPERATION_TIMEOUT=5
DELIVERY_QUEUE_SIZE=256
DELIVERY_ATTEMPTS=5
DELIVERY_RETRY_INITIAL=0.5
DELIVERY_RETRY_MAX=10
DELIVERY_TIMEOUT=2
LIVE_FPS=20
LIVE_MAX_WIDTH=1920
LIVE_JPEG_QUALITY=90
LIVE_OVERLAY_MAX_AGE=0.25
ANPR_DIAGNOSTICS=false
ANPR_DIAGNOSTICS_INTERVAL=1
# Existing re-ID default; not tuned for new hardware/traffic.
TRACK_REID_TIMEOUT=3.0
